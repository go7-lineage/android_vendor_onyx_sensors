prebuilt_etc {
    name: "hexagonrpcd-sensorspd.rc",
    src: "init/hexagonrpcd.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "hexagonrpcd-root-socinfo",
    srcs: ["root/socinfo/*"],
    sub_dir: "hexagonrpcd-root/socinfo",
    vendor: true,
}

install_symlink {
    name: "hexagonrpcd-root-sensors-registry",
    installed_location: "etc/hexagonrpcd-root/sensors/registry",
    symlink_target: "/mnt/vendor/persist/sensors/registry/registry",
    vendor: true,
}

rust_library {
    name: "libssc",
    crate_name: "ssc",
    srcs: ["ssc/src/lib.rs"],
    edition: "2024",
    rustlibs: ["liblibc"],
    vendor: true,
    lints: "android",
    clippy_lints: "android",
}

rust_binary {
    name: "android.hardware.sensors-service.onyx",
    srcs: ["hal/src/main.rs"],
    edition: "2024",
    relative_install_path: "hw",
    init_rc: ["init/sensors-onyx.rc"],
    vintf_fragments: ["init/sensors-onyx.xml"],
    vendor: true,
    prefer_rlib: true,
    rustlibs: [
        "android.hardware.sensors-V3-rust",
        "libbinder_rs",
        "libfmq_rust",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libssc",
    ],
    lints: "android",
    clippy_lints: "android",
}

phony {
    name: "onyx-sensors",
    required: [
        "android.hardware.sensors-service.onyx",
        "hexagonrpcd",
        "hexagonrpcd-root-sensors-registry",
        "hexagonrpcd-root-socinfo",
        "hexagonrpcd-sensorspd.rc",
    ],
}
